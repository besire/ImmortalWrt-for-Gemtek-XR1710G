From bf68417eec8d399e824db99782c977724c1d5664 Mon Sep 17 00:00:00 2001
From: Govindaraj Saminathan <govindaraj.saminathan@oss.qualcomm.com>
Date: Fri, 10 Jul 2026 11:38:24 +0530
Subject: [PATCH] nl80211: Prevent stale event from matching active command
 reply sequence

When an event handler called from nl80211_deliver_pending_events()
issues a driver command, the nested send_and_recv_glb() call appends
new events to global->pending_events while it waits for its reply. On
return, nl80211_reply_hook() sees global->pending_events as non-empty
and re-queues the current event instead of processing it. This repeats
for every remaining event in the delivery batch.

The sequence that triggers the bug:

  Phase 1 - kernel events arrive during a sync command:
    send_and_recv_glb() sets sync_reply_handling=true, reply_seq=SEQ_1
    nl_recvmsgs() receives events E1, E2, E3
      -> nl80211_reply_hook(): sync=true, seq != SEQ_1 -> queued
      -> global->pending_events = {E1, E2, E3}
    ACK(SEQ_1) arrives -> loop exits
    sync_reply_handling=false, reply_seq=0

  Phase 2 - delivery; E1's handler issues a nested command:
    nl80211_deliver_pending_events() is called by eloop
      {E1,E2,E3} moved from global->pending_events to a stack-local
      list; global->pending_events = {} (now empty)
      local list = {E1, E2, E3}  <- iterated by the delivery loop
    Delivers E1 -> handler calls send_and_recv_glb()
      sync_reply_handling=true, reply_seq=SEQ_2
      nl_recvmsgs() receives F1, F2
        -> nl80211_reply_hook(): sync=true, seq != SEQ_2 -> queued
        -> global->pending_events = {F1, F2}
      ACK(SEQ_2) -> send_and_recv_glb() returns
      sync_reply_handling=false
      global->pending_events = {F1, F2}  <- non-empty now
      local list still has {E2, E3}      <- not yet delivered

  Phase 3 - the re-queuing trap (without this fix):
    Delivery loop resumes; delivers E2 -> nl80211_reply_hook()
      sync_reply_handling=false
      global->pending_events = {F1, F2}  <- non-empty!
      -> re-queues E2 into global: pending_events = {F1, F2, E2}
      -> returns NL_SKIP
    E2 is removed from the local list but not processed; it will
    only be re-delivered in the next eloop cycle, behind F1 and F2.
    E3 suffers the same fate.

Under sustained high-frequency command sequences the re-queuing
accumulates stale events. Each retains its original kernel sequence
number. When the accumulated count is large enough, a stale event's
nlmsg_seq coincidentally matches the reply_seq of an active
send_and_recv_glb() call. nl80211_reply_hook() fires the reply handler
with the wrong message, writing garbage into the caller's local stack
variable and causing SIGSEGV.

Fix: add a delivering_pending_events flag to nl80211_global, set it
around the delivery loop in nl80211_deliver_pending_events(), and skip
the re-queue in nl80211_reply_hook() when the flag is set.

An event delivered from the local list was queued before any event
that arrives during delivery; re-queuing it behind those later arrivals
reverses order rather than preserving it. Processing it directly keeps
correct arrival order; new events that arrive during delivery are
queued and handled in the next eloop cycle.

Fixes: f5790e97cd64 ("nl80211: Delay event processing during command handling")
Signed-off-by: Govindaraj Saminathan <govindaraj.saminathan@oss.qualcomm.com>
---
 src/drivers/driver_nl80211.c | 19 +++++++++++++++++--
 src/drivers/driver_nl80211.h |  2 ++
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/src/drivers/driver_nl80211.c b/src/drivers/driver_nl80211.c
index 469a542..6e806f0 100644
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -539,6 +539,8 @@ static void nl80211_deliver_pending_events(void *eloop_ctx, void *data)
 	if (dl_list_empty(&global->pending_events))
 		return;
 
+	global->delivering_pending_events = true;
+
 	dl_list_init(&pending_events);
 
 	global->pending_events.next->prev = &pending_events;
@@ -555,6 +557,8 @@ static void nl80211_deliver_pending_events(void *eloop_ctx, void *data)
 		event->handler(event->msg, event->data);
 		nl80211_remove_pending_event(event);
 	}
+
+	global->delivering_pending_events = false;
 }
 
 
@@ -575,9 +579,20 @@ int nl80211_reply_hook(struct nl80211_global *global, struct nl_msg *msg,
 		 * to read the socket again (it should usually, but it may not
 		 * if multiple timeouts have expired). As such, check here if
 		 * there are already pending events, and if there are, queue
-		 * this one.
+		 * this one to preserve delivery order.
+		 *
+		 * However, if we are already inside
+		 * nl80211_deliver_pending_events(), do not re-queue events
+		 * triggered by event handlers. Re-queuing during delivery
+		 * causes events to accumulate across command cycles. When the
+		 * accumulated event count is large enough, a re-queued event's
+		 * sequence number eventually matches the reply_seq of a
+		 * concurrent send_and_recv_glb() call, causing the reply
+		 * handler to fire with the wrong message and corrupt the
+		 * caller's stack.
 		 */
-		if (!dl_list_empty(&global->pending_events))
+		if (!dl_list_empty(&global->pending_events) &&
+		    !global->delivering_pending_events)
 			goto queue_event;
 
 		return NL_OK;
diff --git a/src/drivers/driver_nl80211.h b/src/drivers/driver_nl80211.h
index 9c871ce..75f9047 100644
--- a/src/drivers/driver_nl80211.h
+++ b/src/drivers/driver_nl80211.h
@@ -48,6 +48,8 @@ struct nl80211_global {
 
 	/* pending events that happened while waiting for a sync reply */
 	struct dl_list pending_events;
+	/* set while nl80211_deliver_pending_events() is running */
+	bool delivering_pending_events;
 #ifdef CONFIG_NAN
 	/* Dedicated socket for NAN interface creation and events */
 	struct nl_sock *nl_nan;
